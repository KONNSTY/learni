# Kopiere nach .env (wird von git ignoriert). Alle Werte sind Platzhalter.
APP_ENV=dev                       # dev | prod
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8081

# Supabase (serverseitig!)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=        # NIE in den Client / EXPO_PUBLIC_*

# Redis (optional, sonst In-Memory)
REDIS_URL=

# LLM-Gateway (LiteLLM oder OpenRouter, OpenAI-kompatibel)
LLM_GATEWAY_URL=
LLM_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_EVAL=
LLM_MODEL_PREMIUM=
LLM_FAILOVER_MODELS=              # kommagetrennt

# STT
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# TTS / Aussprache
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_PROVIDER=auto                 # auto | azure | elevenlabs | piper | mock
PIPER_CMD=
PIPER_MODEL_DIR=

# Abrechnung
REVENUECAT_WEBHOOK_SECRET=

# n8n (spaeter)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Feature-Flags (Standard: aus, damit frei getestet werden kann)
FLAG_BOT_PROTECTION=false
FLAG_CAPTCHA=false
FLAG_REQUIRE_EMAIL_VERIFICATION=false
FLAG_LOGIN_RATE_LIMITS=false
