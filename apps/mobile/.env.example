# Kopiere nach .env (git-ignoriert). NUR oeffentliche Werte! Niemals Service-Role-, LLM-, STT-, TTS- oder Webhook-Secrets hierhin.
EXPO_PUBLIC_API_MODE=mock                 # mock = lokaler Testmodus ohne Backend | http
EXPO_PUBLIC_API_URL=                      # z. B. http://192.168.0.10:8000 (LAN-IP des Rechners) oder Tunnel-URL
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=            # Anon-Key ist oeffentlich, RLS schuetzt die Daten
EXPO_PUBLIC_REVENUECAT_IOS_KEY=           # oeffentlicher SDK-Key (appl_...)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
